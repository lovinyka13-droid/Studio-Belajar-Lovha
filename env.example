# Salin menjadi .env (atau .env.local) lalu isi nilainya. JANGAN commit file .env.
# Semua rahasia hanya dipakai di sisi server.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Kunci di bawah ini hanya untuk server, jangan pernah dikirim ke browser
SUPABASE_SERVICE_ROLE_KEY=

# Model AI (penyedia belum diputuskan; sesuaikan nama variabel dengan penyedia yang dipilih)
AI_API_KEY=

# OCR / pengenalan tulisan tangan dan rumus (layanan belum dipilih)
OCR_API_KEY=

# ASR / TTS (layanan belum dipilih, Tahap 4)
ASR_API_KEY=
TTS_API_KEY=

# Object storage untuk foto, PDF, audio (bucket privat)
STORAGE_BUCKET=
